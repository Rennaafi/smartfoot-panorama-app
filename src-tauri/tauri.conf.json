{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SmartFoot",
  "version": "0.2.0",
  "identifier": "id.ac.ui.smartfoot",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SmartFoot",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}